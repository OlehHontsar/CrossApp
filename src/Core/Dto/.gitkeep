using System;
using Core.Dto;

namespace Core.Domain;

public sealed class Product
{
    private int _quantity;

    public string Id { get; }
    public string Sku { get; }
    public string Name { get; }
    public string Unit { get; }
    public int Quantity => _quantity;

    // Конструктор приватний — ніхто ззовні не створить об'єкт в обхід перевірок
    private Product(string id, string sku, string name, string unit, int quantity)
    {
        Id = id;
        Sku = sku;
        Name = name;
        Unit = unit;
        _quantity = quantity;
    }

    // Фабричний метод (Єдиний спосіб створення)
    public static Product Create(string id, string sku, string name, string unit, int quantity)
    {
        if (string.IsNullOrWhiteSpace(id))
            throw new ArgumentException("Ідентифікатор товару є обов'язковим.", nameof(id));
        if (string.IsNullOrWhiteSpace(sku))
            throw new ArgumentException("SKU не може бути порожнім.", nameof(sku));
        if (string.IsNullOrWhiteSpace(name))
            throw new ArgumentException("Назва не може бути порожньою.", nameof(name));
        if (string.IsNullOrWhiteSpace(unit))
            throw new ArgumentException("Одиниця виміру має бути вказана.", nameof(unit));
        
        // Інваріант 1: Залишок не може бути від'ємним при створенні
        if (quantity < 0)
            throw new ArgumentOutOfRangeException(nameof(quantity), quantity, "Початковий залишок не може бути від'ємним.");

        return new Product(id.Trim(), sku.Trim().ToUpperInvariant(), name.Trim(), unit.Trim(), quantity);
    }

    public void RegisterArrival(int amount)
    {
        // Інваріант 2: Зміна стану вимагає лише додатні числа
        if (amount <= 0)
            throw new ArgumentOutOfRangeException(nameof(amount), amount, "Кількість приходу має бути більшою за нуль.");
        _quantity += amount;
    }

    public void Issue(int amount)
    {
        if (amount <= 0)
            throw new ArgumentOutOfRangeException(nameof(amount), amount, "Кількість видачі має бути більшою за нуль.");
        
        // Інваріант 3: Залишок не може піти в мінус (Перевитрата)
        if (amount > _quantity)
            throw new InvalidOperationException($"Не можна видати {amount} {Unit}: недостатньо товару. Поточний залишок {Sku} = {_quantity}");

        _quantity -= amount;
    }

    // Мапінг у DTO тижня 3 і назад
    public ProductDto ToDto() => new(Id, Sku, Name, Unit, Quantity, null);

    public static Product FromDto(ProductDto dto) => Create(dto.Id, dto.Sku, dto.Name, dto.Unit, dto.Quantity);

    public override string ToString() => $"{Id} [{Sku}] {Name} — {Quantity} {Unit}";
}
